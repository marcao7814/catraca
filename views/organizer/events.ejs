<h1>Meus eventos</h1>
<p><a href="/organizer/events/new">+ Novo evento</a></p>
<% if (events.length === 0) { %>
  <p>Você ainda não tem eventos.</p>
<% } else { %>
  <table id="organizer-events">
    <thead><tr><th>Evento</th><th>Início</th><th>Local</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const e of events) { %>
        <tr data-event-id="<%= e.id %>">
          <td><a href="/organizer/events/<%= e.id %>"><%= e.name %></a></td>
          <td><%= formatDisplay(e.startsAt) %></td>
          <td><%= e.venue %></td>
          <td><%= STATUS_LABEL[e.status] %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>
