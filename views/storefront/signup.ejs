<h1>Criar conta</h1>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form method="post" action="/signup">
  <label for="name">Nome</label>
  <input id="name" name="name" value="<%= values.name %>" required maxlength="200" autocomplete="name">
  <label for="email">E-mail</label>
  <input id="email" name="email" type="email" value="<%= values.email %>" required autocomplete="username">
  <label for="password">Senha (mínimo 6 caracteres)</label>
  <input id="password" name="password" type="password" required minlength="6" autocomplete="new-password">
  <p><button type="submit">Criar conta</button></p>
</form>
<p>Já tem conta? <a href="/login">Entrar</a></p>
